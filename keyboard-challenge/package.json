{
  "name": "keyboard-challenge-abu-jinan",
  "version": "1.0.0",
  "description": "تحدي الـ Keyboard مع أبو جنان — سباق كتابة عربي متعدد اللاعبين",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "start:dist": "STATIC_DIR=dist node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "check": "node scripts/check.js && node scripts/validate-texts.js && node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "build": "node scripts/build.js"
  }
}
